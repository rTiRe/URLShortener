{
    "compilerOptions": {
        "target": "es5",
        "module": "umd",
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": false,
        "removeComments": true,
        "esModuleInterop": true,
        "outDir": "dist",
        "baseUrl": "src",
        "moduleResolution": "node",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true
    },
    "exclude": [
        "node_modules"
    ],
    "include": [
        "src"
    ]
}